{
  "name": "paste-smart",
  "author": "theprinceraj",
  "license": "MIT",
  "private": true,
  "version": "0.1.6",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "check:repo": "bun scripts/check-repo.mjs",
    "fix": "bun run lint:fix && bun run format",
    "preflight": "bun run fix && bun run check:repo && bunx tsc --noEmit && bun run lint && bun run format:check",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-clipboard-manager": "~2",
    "@tauri-apps/plugin-global-shortcut": "~2",
    "@typesafe-ai/sdk": "^0.6.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "husky": "^9.1.7",
    "oxlint": "^1.83.0",
    "prettier": "^3.9.8",
    "typescript": "~6.0.3",
    "vite": "^8.0.16"
  }
}
