{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "settings-desktop-capability",
  "description": "Desktop-only permissions for the Settings window's launch-on-startup toggle",
  "platforms": ["macOS", "windows", "linux"],
  "windows": ["settings"],
  "permissions": [
    "autostart:allow-enable",
    "autostart:allow-disable",
    "autostart:allow-is-enabled"
  ]
}
